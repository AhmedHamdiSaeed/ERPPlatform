{
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=ERPPlatform;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "OpenIddict": {
    // RootUrl is the LOCAL development origin. AdditionalRedirectUris holds every other origin the
    // same client is used from. Both are written to the client on every migration - the seeder
    // replaces a client's RedirectUris whenever they differ from configuration, so anything not
    // listed here is silently lost the next time the DbMigrator runs.
    "Applications": {
      "ERPPlatform_App": {
        "ClientId": "ERPPlatform_App",
        "RootUrl": "http://localhost:4200",
        "AdditionalRedirectUris": [ "https://erpplatform.runasp.net", "https://erpplatform-one.vercel.app", "https://erpplatform-rose.vercel.app", "https://shiny-crisp-94db4d.netlify.app" ]
      },
      "ERPPlatform_Swagger": {
        "ClientId": "ERPPlatform_Swagger",
        "RootUrl": "https://localhost:44327",
        "AdditionalRedirectUris": [ "https://erpplatform.runasp.net" ]
      }
    }
  }
}
