# ============================================================
# Stage 1 – Build Angular app
# ============================================================
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files first for cached npm install
COPY angular/package.json angular/package-lock.json ./

RUN npm ci

# Copy the rest of the Angular source
COPY angular/ .

# Build with the docker-specific environment configuration
RUN npm run build:prod

# ============================================================
# Stage 2 – Serve with Nginx
# ============================================================
FROM nginx:alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY angular/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built Angular app
COPY --from=build /app/dist/ERPPlatform /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
