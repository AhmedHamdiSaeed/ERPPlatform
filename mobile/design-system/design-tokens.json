{
  "appName": "ERPPlatform",
  "appTitle": "ERP Platform — Enterprise Resource Planning Suite",
  "typography": {
    "fontFamily": "Inter",
    "fallback": ["system-ui", "-apple-system", "sans-serif"],
    "weights": [300, 400, 500, 600, 700, 800, 900],
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
  },
  "themes": {
    "light": {
      "primary": "#2563eb",
      "primaryHover": "#1d4ed8",
      "primaryLight": "#eff6ff",
      "background": "#f8fafc",
      "surface": "#ffffff",
      "onBackground": "#0f172a",
      "onSurface": "#0f172a",
      "textMain": "#0f172a",
      "textMuted": "#64748b",
      "border": "#e2e8f0",
      "shadow": {
        "sm": "0 1px 3px rgba(0,0,0,0.05)",
        "md": "0 4px 6px -1px rgba(0,0,0,0.07), 0 2px 4px -1px rgba(0,0,0,0.04)",
        "lg": "0 10px 15px -3px rgba(0,0,0,0.08), 0 4px 6px -2px rgba(0,0,0,0.03)"
      },
      "radius": {
        "sm": 6,
        "md": 10,
        "lg": 14
      }
    },
    "dark": {
      "primary": "#3b82f6",
      "primaryHover": "#60a5fa",
      "primaryLight": "#1e293b",
      "background": "#0f172a",
      "surface": "#1e293b",
      "onBackground": "#f8fafc",
      "onSurface": "#f8fafc",
      "textMain": "#f8fafc",
      "textMuted": "#94a3b8",
      "border": "#334155",
      "shadow": {
        "sm": "0 1px 3px rgba(0,0,0,0.3)",
        "md": "0 4px 6px -1px rgba(0,0,0,0.4)",
        "lg": "0 10px 15px -3px rgba(0,0,0,0.5)"
      },
      "radius": {
        "sm": 6,
        "md": 10,
        "lg": 14
      }
    }
  },
  "statusColors": {
    "success": {
      "bg": "#dcfce7",
      "text": "#15803d",
      "variants": ["active", "completed", "present", "approved"]
    },
    "warning": {
      "bg": "#fef9c3",
      "text": "#a16207",
      "variants": ["pending", "in_transit", "in_review"]
    },
    "error": {
      "bg": "#fee2e2",
      "text": "#b91c1c",
      "variants": ["inactive", "failed", "absent", "rejected"]
    },
    "info": {
      "bg": "#e0e7ff",
      "text": "#4338ca",
      "variants": ["late", "on_leave", "remote"]
    }
  },
  "accentColors": {
    "blue":    {"50": "#eff6ff", "100": "#dbeafe", "500": "#3b82f6", "600": "#2563eb", "700": "#1d4ed8", "900": "#1e3a8a"},
    "indigo":  {"100": "#e0e7ff", "500": "#6366f1", "900": "#312e81"},
    "emerald": {"50": "#ecfdf5", "100": "#d1fae5", "400": "#34d399", "500": "#10b981", "600": "#059669", "900": "#064e3b"},
    "amber":   {"50": "#fffbeb", "100": "#fef3c7", "600": "#d97706", "900": "#78350f"},
    "rose":    {"50": "#fff1f2", "100": "#ffe4e6", "500": "#f43f5e", "600": "#e11d48", "900": "#881337"},
    "red":     {"50": "#fef2f2", "500": "#ef4444", "700": "#b91c1c"},
    "slate":   {"50": "#f8fafc", "100": "#f1f5f9", "200": "#e2e8f0", "300": "#cbd5e1", "400": "#94a3b8", "500": "#64748b", "600": "#475569", "700": "#334155", "800": "#1e293b", "900": "#0f172a"}
  },
  "icons": {
    "library": "PrimeIcons",
    "cdn": "https://unpkg.com/primeicons/primeicons.css"
  },
  "logo": {
    "light": "assets/images/logo/logo-light.png",
    "thumbnail": "assets/images/logo/logo-light-thumbnail.png"
  }
}
