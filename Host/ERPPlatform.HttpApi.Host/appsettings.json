{
  "App": {
    "SelfUrl": "https://localhost:44327",
    "ClientUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.ERPPlatform.com,http://localhost:4200",
    "RedirectAllowedUrls": "http://localhost:4200"
  },
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=ERPPlatform;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AuthServer": {
    "Authority": "https://localhost:44327",
    "RequireHttpsMetadata": false,
    "SwaggerClientId": "ERPPlatform_Swagger"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "CHANGE_ME_IN_SECRETS"
  },
  "Auth": {
    "AccessTokenLifetimeMinutes": 30,
    "RefreshTokenLifetimeDays": 180,
    "JwtSecret": "CHANGE_ME_IN_SECRETS_MUST_BE_32_CHARS!"
  },
  "Brevo": {
    "ApiKey": "",
    "SenderEmail": "noreply@erpplatform.com",
    "SenderName": "ERP Platform",
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": ""
  },
  "AI": {
    "Enabled": false,
    "Provider": "OpenAI",
    "ApiKey": "",
    "Endpoint": "https://api.openai.com/v1/chat/completions",
    "Model": "gpt-4o-mini",
    "MaxTokens": 800,
    "Temperature": 0.3
  },
  "EmployeeImport": {
    "ChunkSize": 100,
    "MaxFileSizeBytes": 26214400,
    "MaxTotalRows": 100000,
    "MaxChunkAttempts": 5,
    "ProgressNotificationEveryNChunks": 1,
    "SourceFileRetentionDays": 30,
    "QueueName": "employee-import",
    "StuckChunkTimeoutMinutes": 30,
    "DeleteSourceFileAfterSuccess": true
  }
}
