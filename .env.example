# ============================================================
#  ERPPlatform – Production Environment Variables
#  Copy this file to .env and fill in your real values.
#  .env is gitignored and will NOT be committed.
# ============================================================

# ── Database ──
ConnectionStrings__Default=Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=False;MultipleActiveResultSets=True

# ── Auth Secrets ──
StringEncryption__DefaultPassPhrase=YOUR_16_CHAR_PASSPHRASE
Auth__JwtSecret=YOUR_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARS!

# ── App URLs (adjust for your production domain) ──
App__SelfUrl=https://api.yourdomain.com
App__ClientUrl=https://yourdomain.com
App__CorsOrigins=https://yourdomain.com
App__RedirectAllowedUrls=https://yourdomain.com
AuthServer__Authority=https://api.yourdomain.com
AuthServer__RequireHttpsMetadata=true

# ── Email (Brevo) ──
Brevo__ApiKey=
Brevo__SmtpUser=
Brevo__SmtpPassword=

# ── AI ──
AI__ApiKey=
